# Copy to .env for local dev. In CI, set these as GitHub Actions secrets.

# --- LLM providers (at least one required) ---
NVIDIA_NIM_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- TTS provider (F5-TTS — local, no API key needed) ---
# Path to a 5-15 s reference WAV committed in the repo. F5-TTS clones the
# voice style from this file. Recommended: 24 kHz mono WAV, clean speech.
F5_REF_AUDIO=assets/voice_ref.wav
# Transcript of the reference audio (improves quality). Leave empty to let
# F5-TTS run its built-in ASR (slower, uses more RAM).
F5_REF_TEXT=

# --- Stock media (optional but strongly recommended) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (required for upload stage) ---
# Generate via scripts/generate_youtube_token.py (see README)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Behaviour flags ---
# Set to "1" to skip the actual YouTube upload (useful for dry runs)
DRY_RUN=0
# Override the run date (YYYY-MM-DD); defaults to today UTC
RUN_DATE=
